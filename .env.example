# Environment variables for local development
# Copy this file to `.env` and fill in values.

# Database URL (required)
# Get this from your Railway Postgres resource. Example format:
# postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:port/railway

# Base URL of the web app (used by worker). For local dev use http://localhost:5000
BASE_URL=http://localhost:5000

# Dedicated service credential: generate once and set the SAME value on web and worker.
# Required for automatic history. At least 32 characters; no browser cookies are used.
WORKER_KEY=
# Use the same interval on both services (seconds, 300–86400).
HISTORY_INTERVAL_SECONDS=3600
INITIAL_DELAY_SECONDS=10

# Logging level (optional): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
